# Secrets / env
.env
.env.local
.env.*.local

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
build/
.next/
.vite/
*.tsbuildinfo

# Cloudflare / wrangler
.wrangler/

# Video: keep the storyboard source (HTML/JS/md); the rendered frames under
# video/shots/ are regenerable outputs (and exceed the 500KB commit cap).
video/shots/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/
.qoder/

# DeepPCB: the 30-pair demo subset (images + annotations) and the recorded ledgers are
# committed, so a fresh clone can run the demo with no download step. Anything else
# dropped under data/ — the full dataset, archives — stays out.
data/*
!data/deeppcb/
data/deeppcb/*
!data/deeppcb/images/
!data/deeppcb/annotations/
!data/deeppcb/corrections.jsonl
!data/deeppcb/comparison.json
!data/deeppcb/runs.jsonl
# Foundry (Lane 3): netlists, golden replay, demo script — committed so the autonomous
# demo runs offline from a fresh clone.
!data/foundry/

# Demo film: renders, intermediates, screen captures and the music bed are
# regenerable / exceed the 500KB commit cap. Scripts, EDL, narration, VO + SFX are tracked.
video/demo/out/
video/demo/work/
video/demo/clips/
video/demo/vo_samples/
video/demo/audio/bed.mp3
video/recon/
