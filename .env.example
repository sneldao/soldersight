# Mubit API key (routes calls via https://api.mubit.ai — /openai/v1, /anthropic,
# /compat/{service}/v1 for registered OpenAI-compatible providers)
MUBIT_API_KEY=

# Tavily API key (web research and sourcing)
TAVILY_API_KEY=

# --- Policy gate (Banyan Sapling) ---
# Research-preview endpoint override; point this at self-hosted open weights
# (hf download MubitLabs/banyan-sapling) if the preview is down.
# BANYAN_ENDPOINT=

# Optional Mubit route overrides for the vision model
# MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# MUBIT_MODEL=gpt-4o-mini

# --- Gate redundancy (glasses / offline demos; all optional) ---
# Enable the independent LLM verifier rung in glasses.gate_for:
# GLASSES_LLM_GATE=1
# Mubit /compat/groq/v1 works with just MUBIT_API_KEY once a Groq key is
# registered under Provider keys in the console. Override its model:
# GROQ_MODEL=openai/gpt-oss-120b
# Direct free-tier fallback (no Mubit):
# EVOMAP_API_KEY=
# EVOMAP_BASE_URL=https://api.evomap.ai/v1
# EVOMAP_MODEL=evomap-glm-5.1
